VERCEL_OIDC_TOKEN=        # run: vercel env pull .env.local
DAYTONA_API_KEY=
DAYTONA_API_URL=          # optional, defaults to https://app.daytona.io/api
DAYTONA_AUTO_STOP_MINUTES=30  # delete an abandoned sandbox after this inactivity period
DAYTONA_CAPACITY_CLEANUP_MINUTES=0  # on capacity exhaustion, reclaim all existing previews immediately; set a positive age to preserve newer previews
PREVIEW_INSTALL_TIMEOUT_SECONDS=120  # fail clearly instead of waiting indefinitely on dependency installation
NEXT_PUBLIC_APP_URL=http://localhost:3000
UPSTASH_REDIS_REST_URL=       # Vercel KV / Upstash REST endpoint
UPSTASH_REDIS_REST_TOKEN=     # Vercel KV / Upstash REST token
NEXT_PUBLIC_PREVIEW_PROXY_DOMAIN= # e.g. preview.example.com; enables the inline Daytona preview proxy
PARALLEL_API_KEY=          # Parallel Search API key for repo search (optional; feature hides if unset)
